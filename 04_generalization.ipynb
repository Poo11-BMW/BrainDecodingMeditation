   "source": [
    "## 🔬 Hard Subjects Analysis\n",
    "\n",
    "Identify subjects with low accuracy — their data may reveal interesting individual differences."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "loso_df = pd.DataFrame({\n",
    "    'Subject':       list(loso_results.keys()),\n",
    "    'LOSO_Accuracy': [v * 100 for v in loso_results.values()],\n",
    "    'CORAL_Accuracy':[coral_results.get(s, 0) * 100 for s in loso_results.keys()]\n",
    "})\n",
    "loso_df['CORAL_Improvement'] = loso_df['CORAL_Accuracy'] - loso_df['LOSO_Accuracy']\n",
    "loso_df = loso_df.sort_values('LOSO_Accuracy')\n",
    "\n",
    "print('📋 Subject Performance Breakdown:')\n",
    "print(loso_df.to_string(index=False))\n",
    "\n",
    "# Flag hard subjects (below chance + 10%)\n",
