   "source": [
    "# 🌍 Phase 4: Cross-Subject Generalization\n",
    "\n",
    "The **hardest and most publishable problem** in EEG research. Brain signals vary enormously between people — a model trained on 39 subjects often fails on the 40th.\n",
    "\n",
    "This notebook implements:\n",
    "\n",
    "| Method | What it does |\n",
    "|---|---|\n",
    "| **LOSO-CV** | Leave-One-Subject-Out cross-validation — true generalization estimate |\n",
    "| **CORAL** | CORrelation ALignment — aligns feature covariances across subjects |\n",
    "| **Euclidean Alignment (EA)** | Re-centers EEG epochs per subject before feature extraction |\n",
    "| **Subject-Adaptive Fine-tuning** | Take pretrained model + fine-tune 2 layers on 1-min of new subject data |"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "import json\n",
    "import mne\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import joblib\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "from pathlib import Path\n",
    "from sklearn.ensemble import RandomForestClassifier\n",
    "from sklearn.preprocessing import LabelEncoder, StandardScaler\n",
    "from sklearn.metrics import accuracy_score, classification_report\n",
    "from sklearn.pipeline import Pipeline\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "mne.set_log_level('WARNING')\n",
    "\n",
    "OUTPUT_PATH = Path(os.getcwd()) / 'processed'\n",
    "MODEL_PATH  = Path(os.getcwd()) / 'models'\n",
    "\n",
    "tasks = ['med1breath', 'med2', 'think1', 'think2']\n",
    "le    = LabelEncoder().fit(tasks)\n",
    "\n",
    "# Load all subjects from processed epochs\n",
    "all_subjects = sorted(set(\n",
    "    p.stem.split('_task')[0]\n",
    "    for p in OUTPUT_PATH.glob('*_task-med1breath_epochs.fif')\n",
    "))\n",
    "print(f'✅ Found {len(all_subjects)} subjects')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 🔄 Method 1: Leave-One-Subject-Out Cross-Validation (LOSO-CV)\n",
    "\n",
    "> The **gold standard** for EEG generalization studies. Each subject is used as the test set once. Final accuracy = mean ± std across all folds.\n",
    ">\n",
    "> This is what reviewers look for in *Journal of Neural Engineering*."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def load_features_for_subjects(subject_list):\n",
    "    \"\"\"Load comprehensive features CSV and filter by subject list.\"\"\"\n",
    "    df = pd.read_csv(OUTPUT_PATH / 'comprehensive_features.csv')\n",
    "    return df[df['Subject'].isin(subject_list)].copy()\n",
    "\n",
    "\n",
    "def loso_cv(classifier_fn, all_subjects, feature_cols=None):\n",
    "    \"\"\"\n",
    "    Leave-One-Subject-Out cross-validation.\n",
    "    classifier_fn: callable that returns a fresh sklearn estimator.\n",
    "    Returns per-subject accuracy list and mean/std.\n",
    "    \"\"\"\n",
    "    df_all = pd.read_csv(OUTPUT_PATH / 'comprehensive_features.csv')\n",
    "    if feature_cols is None:\n",
    "        feature_cols = [c for c in df_all.columns if c not in ['Subject', 'Task']]\n",
    "\n",
    "    subject_accs = {}\n",
    "\n",
    "    for test_subj in all_subjects:\n",
    "        train_subjs = [s for s in all_subjects if s != test_subj]\n",
    "\n",
    "        train_df = df_all[df_all['Subject'].isin(train_subjs)]\n",
    "        test_df  = df_all[df_all['Subject'] == test_subj]\n",
    "\n",
    "        X_train = train_df[feature_cols].values\n",
    "        y_train = le.transform(train_df['Task'])\n",
    "        X_test  = test_df[feature_cols].values\n",
    "        y_test  = le.transform(test_df['Task'])\n",
    "\n",
    "        # Scale: fit on train, transform test\n",
    "        scaler  = StandardScaler()\n",
    "        X_train = scaler.fit_transform(X_train)\n",
    "        X_test  = scaler.transform(X_test)\n",
    "\n",
    "        clf = classifier_fn()\n",
    "        clf.fit(X_train, y_train)\n",
    "        acc = accuracy_score(y_test, clf.predict(X_test))\n",
    "        subject_accs[test_subj] = acc\n",
    "        print(f'   {test_subj}: {acc*100:.1f}%')\n",
    "\n",
    "    accs = list(subject_accs.values())\n",
    "    print(f'\\n📊 LOSO Accuracy: {np.mean(accs)*100:.2f}% ± {np.std(accs)*100:.2f}%')\n",
    "    return subject_accs\n",
    "\n",
    "\n",
    "# Run LOSO-CV with Random Forest (the best ML model)\n",
    "print('🔄 Running LOSO-CV with Random Forest...')\n",
    "rf_fn = lambda: RandomForestClassifier(n_estimators=200, max_depth=20,\n",
    "                                        n_jobs=-1, random_state=42)\n",
    "loso_results = loso_cv(rf_fn, all_subjects)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Visualize per-subject LOSO accuracy\n",
    "fig, ax = plt.subplots(figsize=(14, 5))\n",
    "subjects_sorted = sorted(loso_results.keys())\n",
    "accs_sorted     = [loso_results[s] * 100 for s in subjects_sorted]\n",
    "mean_acc        = np.mean(accs_sorted)\n",
    "\n",
    "colors = ['#E91E63' if a < mean_acc else '#4CAF50' for a in accs_sorted]\n",
    "ax.bar(subjects_sorted, accs_sorted, color=colors, edgecolor='white')\n",
    "ax.axhline(mean_acc, color='black', linestyle='--', linewidth=2,\n",
    "           label=f'Mean: {mean_acc:.1f}%')\n",
    "ax.axhline(25, color='gray', linestyle=':', linewidth=1.5,\n",
    "           label='Chance level (25%)')\n",
    "\n",
    "ax.set_xlabel('Subject', fontsize=12)\n",
    "ax.set_ylabel('Accuracy (%)', fontsize=12)\n",
    "ax.set_title('LOSO-CV Per-Subject Accuracy (Random Forest)', fontsize=13, fontweight='bold')\n",
    "ax.set_xticks(range(len(subjects_sorted)))\n",
    "ax.set_xticklabels(subjects_sorted, rotation=45, ha='right', fontsize=8)\n",
    "ax.legend(fontsize=11)\n",
    "ax.grid(axis='y', alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig(OUTPUT_PATH / 'loso_per_subject.png', dpi=150)\n",
    "plt.show()\n",
    "\n",
    "# Save LOSO results\n",
    "pd.DataFrame({\n",
    "    'Subject': list(loso_results.keys()),\n",
    "    'LOSO_Accuracy': list(loso_results.values())\n",
    "}).to_csv(OUTPUT_PATH / 'loso_results.csv', index=False)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 🔀 Method 2: CORAL — CORrelation ALignment\n",
    "\n",
    "CORAL aligns the **second-order statistics (covariance)** of source (train) and target (test) features, reducing domain shift without requiring target labels.\n",
    "\n",
    "$$\\hat{X}_S = X_S C_S^{-1/2} C_T^{1/2}$$\n",
    "\n",
    "This is used within LOSO — each test subject's features are aligned to the training distribution."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def coral_align(X_source, X_target):\n",
    "    \"\"\"\n",
    "    CORAL: Align target features toward source covariance.\n",
    "    X_source, X_target: (n_samples, n_features) numpy arrays.\n",
    "    Returns aligned X_target.\n",
    "    \"\"\"\n",
    "    # Covariance matrices with regularization\n",
    "    C_s = np.cov(X_source, rowvar=False) + np.eye(X_source.shape[1]) * 1e-5\n",
    "    C_t = np.cov(X_target, rowvar=False) + np.eye(X_target.shape[1]) * 1e-5\n",
    "\n",
    "    # Matrix square roots via eigendecomposition\n",
    "    def mat_sqrt(M):\n",
    "        eigvals, eigvecs = np.linalg.eigh(M)\n",
    "        eigvals = np.maximum(eigvals, 0)  # numerical stability\n",
    "        return eigvecs @ np.diag(np.sqrt(eigvals)) @ eigvecs.T\n",
    "\n",
    "    def mat_inv_sqrt(M):\n",
    "        eigvals, eigvecs = np.linalg.eigh(M)\n",
    "        eigvals = np.maximum(eigvals, 1e-10)\n",
    "        return eigvecs @ np.diag(1.0 / np.sqrt(eigvals)) @ eigvecs.T\n",
    "\n",
    "    A = mat_inv_sqrt(C_t) @ mat_sqrt(C_s)\n",
    "    return (X_target - X_target.mean(axis=0)) @ A + X_source.mean(axis=0)\n",
    "\n",
    "\n",
    "def loso_cv_coral(all_subjects):\n",
    "    \"\"\"LOSO-CV with CORAL domain adaptation.\"\"\"\n",
    "    df_all = pd.read_csv(OUTPUT_PATH / 'comprehensive_features.csv')\n",
    "    feature_cols = [c for c in df_all.columns if c not in ['Subject', 'Task']]\n",
    "    subject_accs = {}\n",
    "\n",
    "    for test_subj in all_subjects:\n",
    "        train_subjs = [s for s in all_subjects if s != test_subj]\n",
    "\n",
    "        train_df = df_all[df_all['Subject'].isin(train_subjs)]\n",
    "        test_df  = df_all[df_all['Subject'] == test_subj]\n",
    "\n",
    "        X_train = train_df[feature_cols].values.astype(float)\n",
    "        y_train = le.transform(train_df['Task'])\n",
    "        X_test  = test_df[feature_cols].values.astype(float)\n",
    "        y_test  = le.transform(test_df['Task'])\n",
    "\n",
    "        # Scale first\n",
    "        scaler  = StandardScaler()\n",
    "        X_train = scaler.fit_transform(X_train)\n",
    "        X_test  = scaler.transform(X_test)\n",
    "\n",
    "        # ── CORAL alignment ─────────────────────────────────────────────\n",
    "        X_test_aligned = coral_align(X_train, X_test)\n",
    "\n",
    "        clf = RandomForestClassifier(n_estimators=200, max_depth=20,\n",
    "                                      n_jobs=-1, random_state=42)\n",
    "        clf.fit(X_train, y_train)\n",
    "        acc = accuracy_score(y_test, clf.predict(X_test_aligned))\n",
    "        subject_accs[test_subj] = acc\n",
    "\n",
    "    accs = list(subject_accs.values())\n",
    "    print(f'📊 LOSO + CORAL Accuracy: {np.mean(accs)*100:.2f}% ± {np.std(accs)*100:.2f}%')\n",
    "    return subject_accs\n",
    "\n",
    "\n",
    "print('🔄 Running LOSO-CV + CORAL...')\n",
    "coral_results = loso_cv_coral(all_subjects)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 📐 Method 3: Euclidean Alignment (EA)\n",
    "\n",
    "EA re-centers each subject's EEG epoch covariance to the identity matrix, making features more subject-invariant before extraction. Simpler than CORAL but very effective (He & Wu, 2019)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def euclidean_alignment(epochs_data):\n",
    "    \"\"\"\n",
    "    Euclidean Alignment for a single subject's epochs.\n",
    "    epochs_data: (n_epochs, n_channels, n_times)\n",
    "    Returns aligned epochs of same shape.\n",
    "    \"\"\"\n",
    "    # Mean covariance matrix across epochs\n",
    "    covs = []\n",
    "    for ep in epochs_data:\n",
    "        C = np.cov(ep) + np.eye(ep.shape[0]) * 1e-6\n",
    "        covs.append(C)\n",
    "    mean_cov = np.mean(covs, axis=0)\n",
    "\n",
    "    # Inverse square root of mean covariance\n",
    "    eigvals, eigvecs = np.linalg.eigh(mean_cov)\n",
    "    eigvals = np.maximum(eigvals, 1e-10)\n",
    "    R_inv   = eigvecs @ np.diag(1.0 / np.sqrt(eigvals)) @ eigvecs.T\n",
    "\n",
    "    # Align each epoch\n",
    "    aligned = np.stack([R_inv @ ep for ep in epochs_data])\n",
    "    return aligned\n",
    "\n",
    "\n",
    "def apply_ea_to_all_subjects(subjects):\n",
    "    \"\"\"\n",
    "    Apply EA to all subjects and save EA-aligned epochs.\n",
    "    \"\"\"\n",
    "    for subj in subjects:\n",
    "        for task in tasks:\n",
    "            ep_file  = OUTPUT_PATH / f'{subj}_task-{task}_epochs.fif'\n",
    "            ea_file  = OUTPUT_PATH / f'{subj}_task-{task}_ea_epochs.npy'\n",
    "            lbl_file = OUTPUT_PATH / f'{subj}_task-{task}_ea_labels.npy'\n",
    "\n",
    "            if not ep_file.exists() or ea_file.exists():\n",
    "                continue\n",
    "\n",
    "            epochs = mne.read_epochs(str(ep_file), preload=True, verbose=False)\n",
    "            data   = epochs.get_data()  # (n_ep, n_ch, n_times)\n",
    "\n",
    "            aligned = euclidean_alignment(data)\n",
    "            np.save(ea_file,  aligned)\n",
    "            np.save(lbl_file, np.full(len(aligned), le.transform([task])[0]))\n",
    "            del epochs\n",
    "\n",
    "    print('✅ Euclidean Alignment complete.')\n",
    "\n",
    "\n",
    "print('⏳ Applying Euclidean Alignment...')\n",
    "apply_ea_to_all_subjects(all_subjects)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 🎯 Method 4: Subject-Adaptive Fine-Tuning\n",
    "\n",
    "Take the best pretrained deep learning model (from Phase 3) and **fine-tune only the classifier head** on a small amount of new subject data (simulating a 1-min calibration session)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "sys.path.insert(0, str(Path(os.getcwd())))\n",
    "\n",
    "DEVICE = torch.device('cuda' if torch.cuda.is_available() else\n",
    "                      'mps'  if torch.backends.mps.is_available() else 'cpu')\n",
    "SFREQ  = 128\n",
    "T_LEN  = 256\n",
    "\n",
    "# Load a test subject's epochs as calibration data\n",
    "def load_subject_as_tensor(subject, n_cal_epochs=20):\n",
    "    \"\"\"Load first n_cal_epochs from each task as calibration set.\"\"\"\n",
    "    X, y = [], []\n",
    "    for task in tasks:\n",
    "        ep_file = OUTPUT_PATH / f'{subject}_task-{task}_epochs.fif'\n",
    "        if not ep_file.exists():\n",
    "            continue\n",
    "        epochs = mne.read_epochs(str(ep_file), preload=True, verbose=False)\n",
    "        data   = epochs.get_data()[:n_cal_epochs]\n",
    "        label  = le.transform([task])[0]\n",
    "        for ep in data:\n",
    "            if ep.shape[1] >= T_LEN:\n",
    "                ep = ep[:, :T_LEN]\n",
    "            else:\n",
    "                ep = np.pad(ep, ((0,0), (0, T_LEN - ep.shape[1])))\n",
    "            X.append(ep)\n",
    "            y.append(label)\n",
    "        del epochs\n",
    "    return np.array(X, dtype=np.float32), np.array(y)\n",
    "\n",
    "\n",
    "def fine_tune_model(pretrained_model, cal_X, cal_y, n_epochs=10, lr=1e-4):\n",
    "    \"\"\"\n",
    "    Fine-tune only the classifier head of the pretrained model.\n",
    "    Freezes all layers except the last Linear layer.\n",
    "    \"\"\"\n",
    "    model = pretrained_model\n",
    "\n",
    "    # Freeze all parameters\n",
    "    for param in model.parameters():\n",
    "        param.requires_grad = False\n",
    "\n",
    "    # Unfreeze classifier (last Linear layer)\n",
    "    for module in model.modules():\n",
    "        if isinstance(module, nn.Linear):\n",
    "            last_linear = module\n",
    "    for param in last_linear.parameters():\n",
    "        param.requires_grad = True\n",
    "\n",
    "    optimizer = torch.optim.Adam(filter(lambda p: p.requires_grad, model.parameters()), lr=lr)\n",
    "    criterion = nn.CrossEntropyLoss()\n",
    "\n",
    "    X_t = torch.tensor(cal_X).unsqueeze(1).to(DEVICE)  # (N, 1, n_ch, T)\n",
    "    y_t = torch.tensor(cal_y).long().to(DEVICE)\n",
    "\n",
    "    model.train()\n",
    "    for ep in range(n_epochs):\n",
    "        optimizer.zero_grad()\n",
    "        loss = criterion(model(X_t), y_t)\n",
    "        loss.backward()\n",
    "        optimizer.step()\n",
    "\n",
    "    # Unfreeze all for future use\n",
    "    for param in model.parameters():\n",
    "        param.requires_grad = True\n",
    "\n",
    "    return model\n",
    "\n",
    "\n",
    "print('✅ Fine-tuning functions defined.')\n",
    "print('   Usage: fine_tune_model(pretrained_model, cal_X, cal_y)')"
   ]
  },
  {
